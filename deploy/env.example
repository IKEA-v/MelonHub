BACKEND_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/melonhub-backend:0.1.0
FRONTEND_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/melonhub-frontend:0.1.0
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1
BACKEND_HTTP_PORT=18080
BACKEND_MANAGEMENT_PORT=18081
FRONTEND_HTTP_PORT=5174

CLOUD_DB_HOST=mysql
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=melonhub_rbac
CLOUD_DB_USERNAME=root
CLOUD_DB_PASSWORD=replace-with-database-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
IDENTITY_JWT_SECRET=replace-with-random-secret-at-least-32-characters
IDENTITY_JWT_ISSUER=https://identity.example.edu
IDENTITY_JWT_EXPIRES_SECONDS=7200
CORS_ALLOWED_ORIGINS=http://server-address

CACHE_ENABLED=false
