{
  "openapi": "3.1.0",
  "info": {
    "title": "MelonHub 统一身份与分级管理员 API",
    "version": "1.1.0",
    "description": "统一身份联调接口及分级管理员验收接口。完整控制台与业务接口见仓库 doc/API.md。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "本机联调"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "统一身份与权限"
    },
    {
      "name": "平台管理员"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "security": [],
        "operationId": "loginIdentity",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "登录",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginVO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutIdentity",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "退出登录",
        "responses": {
          "204": {
            "description": "已退出",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getIdentity",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "当前用户、角色与权限",
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "当前身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityCurrentUserVO"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/audit-logs": {
      "get": {
        "operationId": "queryIdentityAuditLogs",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "查询课程业务日志",
        "description": "需要课程系统权限 AV。按授权部门查询已入库的课程业务事件，按时间从新到旧返回。",
        "parameters": [
          {
            "name": "actor",
            "in": "query",
            "description": "操作人姓名或工号",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "description": "已关联操作人的用户主键",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "target",
            "in": "query",
            "description": "操作对象",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "起始时间（含）",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "结束时间（含）",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "课程业务日志分页结果",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "page",
                    "pageSize",
                    "total",
                    "items"
                  ],
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/IdentityAuditLog"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/permissions/{permission}": {
      "get": {
        "operationId": "checkUiPermission",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "校验前端权限",
        "parameters": [
          {
            "name": "permission",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "校验结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Allowed"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/api-permissions/{operationId}": {
      "get": {
        "operationId": "checkApiPermission",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "校验 API 全局权限",
        "description": "使用接入系统声明的 OpenAPI operationId。无权限返回 allowed=false，未登记的操作返回 404。",
        "parameters": [
          {
            "name": "operationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "校验结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiAllowed"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/auth/departments": {
      "get": {
        "operationId": "listIdentityDepartments",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "查询部门",
        "description": "默认页码为 1，每页 20 条。页码小于 1 时按 1 处理，每页条数限制在 1 到 100。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "部门分页结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageDepartment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/departments/{departmentId}/users": {
      "get": {
        "operationId": "listIdentityDepartmentUsers",
        "tags": [
          "统一身份与权限"
