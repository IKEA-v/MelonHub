            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "用户分页结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/auth/users/{userId}": {
      "get": {
        "operationId": "getIdentityUser",
        "tags": [
          "统一身份与权限"
        ],
        "summary": "查询统一身份用户",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "description": "用户资料",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "loginAdminConsole",
        "tags": [
          "平台管理员"
        ],
        "summary": "使用用户名登录管理控制台",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "maxLength": 100,
                    "writeOnly": true
                  },
                  "mfaCode": {
                    "type": "string",
                    "maxLength": 12,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，返回管理员身份与会话",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/AdminPrincipal"
                    },
                    {
                      "type": "object",
                      "required": [
                        "token",
                        "expiresIn",
                        "idleTimeout"
                      ],
                      "properties": {
                        "token": {
                          "type": "string"
                        },
                        "expiresIn": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "idleTimeout": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getAdminConsolePrincipal",
        "tags": [
          "平台管理员"
        ],
        "summary": "获取当前管理员身份",
        "security": [
          {
            "consoleSession": []
          }
        ],
