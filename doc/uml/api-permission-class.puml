@startuml
title API 全局权限查询 · 双策略类图 (Structured vs DDD)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
class IdentityController {
  - identityService: IdentityUseCase
  + apiPermission(authorization: String, operationId: String): Map
}
interface IdentityUseCase <<port>> {
  + checkApiPermission(authorization: String, operationId: String): Map
}
class StructuredIdentityService <<structured>> {
  - identityDao: IdentityDao
  - tokenService: IdentityTokenService
}
class DddIdentityService <<ddd.application>> {
  - repository: IdentityRepositoryPort
  - tokens: IdentityTokenGateway
}
class CoursePermissionCatalog <<ddd.domain.value>> {
  + {static} requirePermissionForOperation(operationId): String
}
class IdentityAccountAggregate <<ddd.domain.model>> {
  + hasUiPermission(code): boolean
}
interface IdentityRepositoryPort <<ddd.domain.repository>>
class JpaIdentityRepositoryAdapter <<ddd.infrastructure>>
class IdentityDao

IdentityController --> IdentityUseCase
StructuredIdentityService ..|> IdentityUseCase
DddIdentityService ..|> IdentityUseCase
StructuredIdentityService --> IdentityDao
DddIdentityService ..> CoursePermissionCatalog
DddIdentityService ..> IdentityAccountAggregate
DddIdentityService --> IdentityRepositoryPort
JpaIdentityRepositoryAdapter ..|> IdentityRepositoryPort
JpaIdentityRepositoryAdapter --> IdentityDao
@enduml
