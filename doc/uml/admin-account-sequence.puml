@startuml
title POST /api/admin/accounts · DDD 策略时序图
hide footbox
skinparam shadowing false
actor "obj: HTTP 调用者" as Caller
participant "controller: AccountController" as C
participant "auth: DddAuthService" as S
participant "repo: AdminAccountRepositoryPort" as P
participant "tree: AdminHierarchy" as T
activate Caller
autonumber
Caller -> C: POST /api/admin/accounts
activate C
C -> S: createAccount(input, actor)
activate S
S -> P: lockAllAccounts()
S -> P: loadHierarchyNodes()
S -> T: validateCreate(actor.id, candidate)
activate T
deactivate T
alt 候选树违反层级或范围不变量
  autonumber stop
  S --> Caller: 409 CONFLICT (DomainException -> ApiException)
else 候选树满足规则
  autonumber resume
  S -> P: createAccount(..., parentId, ...)
  S -> P: replaceAccountApplications / Departments
  autonumber stop
  C --> Caller: 200 {id, username}
end
deactivate S
deactivate C
deactivate Caller
@enduml
