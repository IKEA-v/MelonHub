@startuml
title MelonHub 双策略后端包图 (Structured / DDD 严格分离)
skinparam packageStyle rectangle
skinparam shadowing false
top to bottom direction
package "com.melonhub.rbac" {
  package controller
  package security
  package dto
  package exception
  package config
  package "service.port" as port
  package "service.structured" as structured
  package "service.ddd" {
    package application as ddd_app
    package domain as ddd_domain
    package infrastructure as ddd_infra
  }
  package identity
  package cache
  package dao
  package repository
  package entity
}
controller ..> dto
controller ..> port
controller ..> security
security ..> port
security ..> exception
config ..> port
config ..> security
structured ..|> port
structured ..> dao
structured ..> cache
structured ..> identity
structured ..> exception
ddd_app ..|> port
ddd_app ..> ddd_domain
ddd_app ..> exception
ddd_infra ..|> ddd_domain
ddd_infra ..> dao
ddd_infra ..> cache
ddd_infra ..> identity
dao ..> repository
dao ..> entity
repository ..> entity
@enduml
