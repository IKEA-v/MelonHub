@startuml
title 分级管理员账号 · 双策略类图 (Structured vs DDD)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
class AccountController {
  - auth: AuthUseCase
  + create(body: Account, req: HttpServletRequest): Map
  + update(id: long, body: AccountUpdate, req: HttpServletRequest): Map
}
interface AuthUseCase <<port>> {
  + createAccount(input: Account, actor: AdminPrincipal): long
  + updateAccount(id: long, input: AccountUpdate, actor: AdminPrincipal): void
}
class StructuredAuthService <<structured>> {
  - dao: AuthDao
  - roles: AdminRoleDao
}
class StructuredAdminHierarchyProcedures <<utility>> {
  + {static} findViolations(accounts, roleFunctions): List
  + {static} manages(accounts, actor, target): boolean
  + {static} manageableAccountIds(accounts, actor): Set
}
class DddAuthService <<ddd.application>> {
  - accounts: AdminAccountRepositoryPort
  - roles: AdminRoleRepositoryPort
}
class AdminHierarchy <<ddd.domain.model>> {
  - nodes: Map<Long, AdminNode>
  + validateCreate(actorId, candidate): AdminNode
  + validateUpdate(actorId, proposed): UpdateDecision
  + violations(): List
}
interface AdminAccountRepositoryPort <<ddd.domain.repository>>
class JpaAdminAccountRepositoryAdapter <<ddd.infrastructure>>
class AuthDao

AccountController --> AuthUseCase
StructuredAuthService ..|> AuthUseCase
DddAuthService ..|> AuthUseCase
StructuredAuthService ..> StructuredAdminHierarchyProcedures
StructuredAuthService --> AuthDao
DddAuthService ..> AdminHierarchy
DddAuthService --> AdminAccountRepositoryPort
JpaAdminAccountRepositoryAdapter ..|> AdminAccountRepositoryPort
JpaAdminAccountRepositoryAdapter --> AuthDao
@enduml
