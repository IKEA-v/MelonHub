graph Chen {
graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst, bgcolor="white", pad="0.5", fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=15, pin=true, penwidth=1.5, color="#263e48"];
edge [fontname="Arial", fontsize=15, color="#50616a", penwidth=1.2, labeldistance=1.8, labelangle=25];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">MelonHub / 陈氏 E-R 图 / 05  管理员、会话与软件密钥</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">V7 软件级 RBAC0 | 2026-10-29</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">矩形：实体　菱形：联系　椭圆：属性　下划线：主键</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">1 / M / N：最大基数　单线：可选参与　双线：必须参与</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">关键属性节选；完整字段和外键见原表结构图。</FONT></TD></TR></TABLE>>;
admin_accounts [pos="0,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>控制台管理员</B><BR/><FONT POINT-SIZE="11">admin_accounts</FONT>>];
applications [pos="7,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务软件</B><BR/><FONT POINT-SIZE="11">applications</FONT>>];
admin_sessions [pos="0,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>管理员会话</B><BR/><FONT POINT-SIZE="11">admin_sessions</FONT>>];
application_keys [pos="7,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>软件 API Key</B><BR/><FONT POINT-SIZE="11">application_keys</FONT>>];
admin_accounts__username [pos="-2.1,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>管理员账号<BR/><FONT POINT-SIZE="10">username</FONT></U>>];
admin_accounts__display_name [pos="0,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<显示名称<BR/><FONT POINT-SIZE="10">display_name</FONT>>];
admin_accounts__role [pos="2.1,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<管理员类型<BR/><FONT POINT-SIZE="10">role</FONT>>];
applications__id [pos="5.05,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>软件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
applications__name [pos="7,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
applications__code [pos="8.95,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
admin_sessions__token_hash [pos="-1.2,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>会话标识（哈希）<BR/><FONT POINT-SIZE="10">token_hash</FONT></U>>];
admin_sessions__expires_at [pos="1.2,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<到期时间<BR/><FONT POINT-SIZE="10">expires_at</FONT>>];
application_keys__id [pos="5.05,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>密钥编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
application_keys__key_hash [pos="7,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<密钥哈希<BR/><FONT POINT-SIZE="10">key_hash</FONT>>];
application_keys__expires_at [pos="8.95,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<到期时间<BR/><FONT POINT-SIZE="10">expires_at</FONT>>];
admin_scope [pos="3.5,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="管理范围"];
session_owner [pos="0,0!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="建立"];
key_owner [pos="7,0!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="签发"];
admin_accounts -- admin_accounts__username [];
admin_accounts -- admin_accounts__display_name [];
admin_accounts -- admin_accounts__role [];
applications -- applications__id [];
applications -- applications__name [];
applications -- applications__code [];
admin_sessions -- admin_sessions__token_hash [];
admin_sessions -- admin_sessions__expires_at [];
application_keys -- application_keys__id [];
application_keys -- application_keys__key_hash [];
application_keys -- application_keys__expires_at [];
admin_scope -- admin_accounts [headlabel="M"];
admin_scope -- applications [headlabel="N"];
session_owner -- admin_accounts [headlabel="1"];
session_owner -- admin_sessions [headlabel="N", color="#50616a:#ffffff:#50616a"];
key_owner -- applications [headlabel="1"];
key_owner -- application_keys [headlabel="N", color="#50616a:#ffffff:#50616a"];
}
