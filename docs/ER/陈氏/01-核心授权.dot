graph Chen {
graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst, bgcolor="white", pad="0.5", fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=15, pin=true, penwidth=1.5, color="#263e48"];
edge [fontname="Arial", fontsize=15, color="#50616a", penwidth=1.2, labeldistance=1.8, labelangle=25];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">MelonHub / 陈氏 E-R 图 / 01  组织与软件授权</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">V7 软件级 RBAC0 | 2026-10-29</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">矩形：实体　菱形：联系　椭圆：属性　下划线：主键</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">1 / M / N：最大基数　单线：可选参与　双线：必须参与</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">关键属性节选；完整字段和外键见原表结构图。</FONT></TD></TR></TABLE>>;
departments [pos="0,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>部门</B><BR/><FONT POINT-SIZE="11">departments</FONT>>];
users [pos="6,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务用户</B><BR/><FONT POINT-SIZE="11">users</FONT>>];
roles [pos="12,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>软件角色</B><BR/><FONT POINT-SIZE="11">roles</FONT>>];
permissions [pos="18,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>软件权限</B><BR/><FONT POINT-SIZE="11">permissions</FONT>>];
applications [pos="15,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务软件</B><BR/><FONT POINT-SIZE="11">applications</FONT>>];
departments__id [pos="-1.95,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>部门编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
departments__name [pos="0,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
departments__code [pos="1.95,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
users__id [pos="4.05,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>用户编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
users__name [pos="6,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<姓名<BR/><FONT POINT-SIZE="10">name</FONT>>];
users__external_id [pos="7.95,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<外部用户标识<BR/><FONT POINT-SIZE="10">external_id</FONT>>];
roles__id [pos="10.05,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>角色编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
roles__name [pos="12,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
roles__code [pos="13.95,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
permissions__id [pos="16.05,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>权限编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
permissions__name [pos="18,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
permissions__code [pos="19.95,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
applications__id [pos="13.05,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>软件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
applications__name [pos="15,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
applications__code [pos="16.95,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
member [pos="3,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="加入"];
grant [pos="9,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="分配"];
grant__grant_id [pos="7.6,0.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<本次授予标识<BR/><FONT POINT-SIZE="10">grant_id</FONT>>];
grant__expires_at [pos="10,0.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<分配到期时间<BR/><FONT POINT-SIZE="10">expires_at</FONT>>];
authorize [pos="15,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="授予"];
own_role [pos="12,-0.4!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="拥有角色"];
own_permission [pos="18,-0.4!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="定义权限"];
departments -- departments__id [];
departments -- departments__name [];
departments -- departments__code [];
users -- users__id [];
users -- users__name [];
users -- users__external_id [];
roles -- roles__id [];
roles -- roles__name [];
roles -- roles__code [];
permissions -- permissions__id [];
permissions -- permissions__name [];
permissions -- permissions__code [];
applications -- applications__id [];
applications -- applications__name [];
applications -- applications__code [];
member -- departments [headlabel="M"];
member -- users [headlabel="N"];
grant -- users [headlabel="M"];
grant -- roles [headlabel="N"];
grant -- grant__grant_id [];
grant -- grant__expires_at [];
authorize -- roles [headlabel="M"];
authorize -- permissions [headlabel="N"];
own_role -- applications [headlabel="1"];
own_role -- roles [headlabel="N", color="#50616a:#ffffff:#50616a"];
own_permission -- applications [headlabel="1"];
own_permission -- permissions [headlabel="N", color="#50616a:#ffffff:#50616a"];
}
