graph Chen {
graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst, bgcolor="white", pad="0.5", fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=15, pin=true, penwidth=1.5, color="#263e48"];
edge [fontname="Arial", fontsize=15, color="#50616a", penwidth=1.2, labeldistance=1.8, labelangle=25];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">MelonHub / 陈氏 E-R 图 / 06  通知投递与审计</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">V7 软件级 RBAC0 | 2026-10-29</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">矩形：实体　菱形：联系　椭圆：属性　下划线：主键</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">1 / M / N：最大基数　单线：可选参与　双线：必须参与</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">关键属性节选；完整字段和外键见原表结构图。</FONT></TD></TR></TABLE>>;
applications [pos="0,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务软件</B><BR/><FONT POINT-SIZE="11">applications</FONT>>];
webhooks [pos="6,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>Webhook 订阅</B><BR/><FONT POINT-SIZE="11">webhooks</FONT>>];
webhook_deliveries [pos="12,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>通知投递</B><BR/><FONT POINT-SIZE="11">webhook_deliveries</FONT>>];
audit_events [pos="3,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>审计事件</B><BR/><FONT POINT-SIZE="11">audit_events</FONT>>];
audit_seal [pos="10,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>审计封存状态</B><BR/><FONT POINT-SIZE="11">audit_seal</FONT>>];
applications__id [pos="-0.975,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>软件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
applications__name [pos="0.975,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<软件名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
webhooks__id [pos="4.05,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>订阅编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
webhooks__url [pos="6,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<回调地址<BR/><FONT POINT-SIZE="10">url</FONT>>];
webhooks__events [pos="7.95,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<订阅事件<BR/><FONT POINT-SIZE="10">events</FONT>>];
webhook_deliveries__id [pos="10.05,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>投递编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
webhook_deliveries__status [pos="12,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<投递状态<BR/><FONT POINT-SIZE="10">status</FONT>>];
webhook_deliveries__attempts [pos="13.95,5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<尝试次数<BR/><FONT POINT-SIZE="10">attempts</FONT>>];
audit_events__id [pos="1.05,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>事件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
audit_events__action [pos="3,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<操作<BR/><FONT POINT-SIZE="10">action</FONT>>];
audit_events__chain_hash [pos="4.95,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<链哈希<BR/><FONT POINT-SIZE="10">chain_hash</FONT>>];
audit_seal__id [pos="8.05,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>状态编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
audit_seal__last_seq [pos="10,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<链尾序号<BR/><FONT POINT-SIZE="10">last_seq</FONT>>];
audit_seal__last_hash [pos="11.95,-5.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<链尾哈希<BR/><FONT POINT-SIZE="10">last_hash</FONT>>];
subscribe [pos="3,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="配置"];
deliver [pos="9,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="产生投递"];
applications -- applications__id [];
applications -- applications__name [];
webhooks -- webhooks__id [];
webhooks -- webhooks__url [];
webhooks -- webhooks__events [];
webhook_deliveries -- webhook_deliveries__id [];
webhook_deliveries -- webhook_deliveries__status [];
webhook_deliveries -- webhook_deliveries__attempts [];
audit_events -- audit_events__id [];
audit_events -- audit_events__action [];
audit_events -- audit_events__chain_hash [];
audit_seal -- audit_seal__id [];
audit_seal -- audit_seal__last_seq [];
audit_seal -- audit_seal__last_hash [];
subscribe -- applications [headlabel="1"];
subscribe -- webhooks [headlabel="N", color="#50616a:#ffffff:#50616a"];
deliver -- webhooks [headlabel="1"];
deliver -- webhook_deliveries [headlabel="N", color="#50616a:#ffffff:#50616a"];
}
