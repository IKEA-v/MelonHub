graph Chen {
graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst, bgcolor="white", pad="0.5", fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=15, pin=true, penwidth=1.5, color="#263e48"];
edge [fontname="Arial", fontsize=15, color="#50616a", penwidth=1.2, labeldistance=1.8, labelangle=25];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">MelonHub / 陈氏 E-R 图 / 04  权限复核与历史条目</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">V7 软件级 RBAC0 | 2026-10-29</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">矩形：实体　菱形：联系　椭圆：属性　下划线：主键</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">1 / M / N：最大基数　单线：可选参与　双线：必须参与</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">关键属性节选；完整字段和外键见原表结构图。</FONT></TD></TR></TABLE>>;
applications [pos="-6,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务软件</B><BR/><FONT POINT-SIZE="11">applications</FONT>>];
departments [pos="-6,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>部门</B><BR/><FONT POINT-SIZE="11">departments</FONT>>];
access_reviews [pos="0,0!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>权限复核</B><BR/><FONT POINT-SIZE="11">access_reviews</FONT>>];
access_review_items [pos="6,0!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>复核条目</B><BR/><FONT POINT-SIZE="11">access_review_items</FONT>>];
users [pos="12,3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务用户</B><BR/><FONT POINT-SIZE="11">users</FONT>>];
roles [pos="12,-3!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>软件角色</B><BR/><FONT POINT-SIZE="11">roles</FONT>>];
applications__id [pos="-6.975,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>软件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
applications__name [pos="-5.025,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<软件名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
departments__id [pos="-6.975,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>部门编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
departments__name [pos="-5.025,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<部门名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
users__id [pos="11.025,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>用户编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
users__name [pos="12.975,5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<姓名<BR/><FONT POINT-SIZE="10">name</FONT>>];
roles__id [pos="11.025,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>角色编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
roles__code [pos="12.975,-5.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<角色编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
access_reviews__id [pos="-1,4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>复核编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
access_reviews__name [pos="1.2,4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<复核名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
access_reviews__status [pos="0,-3.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<复核状态<BR/><FONT POINT-SIZE="10">status</FONT>>];
access_review_items__id [pos="5,4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>条目编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
access_review_items__decision [pos="7.2,4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<复核决定<BR/><FONT POINT-SIZE="10">decision</FONT>>];
access_review_items__grant_id [pos="6,-3.5!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<授予标识快照<BR/><FONT POINT-SIZE="10">grant_id</FONT>>];
review_app [pos="-3,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="归属"];
review_filter [pos="-3,-3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="筛选范围"];
review_items [pos="3,0!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="包含"];
review_user [pos="9,3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="被复核用户"];
review_role [pos="9,-3!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="被复核角色"];
applications -- applications__id [];
applications -- applications__name [];
departments -- departments__id [];
departments -- departments__name [];
users -- users__id [];
users -- users__name [];
roles -- roles__id [];
roles -- roles__code [];
access_reviews -- access_reviews__id [];
access_reviews -- access_reviews__name [];
access_reviews -- access_reviews__status [];
access_review_items -- access_review_items__id [];
access_review_items -- access_review_items__decision [];
access_review_items -- access_review_items__grant_id [];
review_app -- applications [headlabel="1"];
review_app -- access_reviews [headlabel="N", color="#50616a:#ffffff:#50616a"];
review_filter -- departments [headlabel="1"];
review_filter -- access_reviews [headlabel="N"];
review_items -- access_reviews [headlabel="1"];
review_items -- access_review_items [headlabel="N", color="#50616a:#ffffff:#50616a"];
review_user -- users [headlabel="1"];
review_user -- access_review_items [headlabel="N"];
review_role -- roles [headlabel="1"];
review_role -- access_review_items [headlabel="N"];
}
