graph Chen {
graph [layout=neato, overlap=true, splines=line, outputorder=edgesfirst, bgcolor="white", pad="0.5", fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
node [fontname="Arial", fontsize=15, pin=true, penwidth=1.5, color="#263e48"];
edge [fontname="Arial", fontsize=15, color="#50616a", penwidth=1.2, labeldistance=1.8, labelangle=25];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">MelonHub / 陈氏 E-R 图 / 03  角色申请与审批记录</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">V7 软件级 RBAC0 | 2026-10-29</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">矩形：实体　菱形：联系　椭圆：属性　下划线：主键</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">1 / M / N：最大基数　单线：可选参与　双线：必须参与</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">关键属性节选；完整字段和外键见原表结构图。</FONT></TD></TR></TABLE>>;
access_requests [pos="0,0!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>角色申请</B><BR/><FONT POINT-SIZE="11">access_requests</FONT>>];
users [pos="-6,0!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务用户</B><BR/><FONT POINT-SIZE="11">users</FONT>>];
roles [pos="6,0!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>软件角色</B><BR/><FONT POINT-SIZE="11">roles</FONT>>];
applications [pos="0,5!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>业务软件</B><BR/><FONT POINT-SIZE="11">applications</FONT>>];
departments [pos="0,-5!", shape=box, style=filled, fillcolor="#e9f3f5", width=2.3, height=0.8, label=<<B>部门</B><BR/><FONT POINT-SIZE="11">departments</FONT>>];
applications__id [pos="-0.975,7.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>软件编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
applications__name [pos="0.975,7.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<软件名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
departments__id [pos="-0.975,-7.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>部门编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
departments__name [pos="0.975,-7.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<部门名称<BR/><FONT POINT-SIZE="10">name</FONT>>];
users__id [pos="-8.5,1.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>用户编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
users__name [pos="-8.5,-1.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<姓名<BR/><FONT POINT-SIZE="10">name</FONT>>];
roles__id [pos="8.5,1.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>角色编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
roles__code [pos="8.5,-1.4!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<角色编码<BR/><FONT POINT-SIZE="10">code</FONT>>];
access_requests__id [pos="-3,2.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<<U>申请编号<BR/><FONT POINT-SIZE="10">id</FONT></U>>];
access_requests__status [pos="3,2.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<审批状态<BR/><FONT POINT-SIZE="10">status</FONT>>];
access_requests__duration_days [pos="-3,-2.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<申请天数<BR/><FONT POINT-SIZE="10">duration_days</FONT>>];
access_requests__grant_expires_at [pos="3,-2.3!", shape=ellipse, width=1.8, height=0.68, fontsize=12, label=<批准后到期时间<BR/><FONT POINT-SIZE="10">grant_expires_at</FONT>>];
requester [pos="-3,0!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="提出"];
requested_role [pos="3,0!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="申请目标"];
request_app [pos="0,2.5!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="归属"];
request_origin [pos="0,-2.5!", shape=diamond, style=filled, fillcolor="#fff3dc", width=1.8, height=1, label="记录来源"];
applications -- applications__id [];
applications -- applications__name [];
departments -- departments__id [];
departments -- departments__name [];
users -- users__id [];
users -- users__name [];
roles -- roles__id [];
roles -- roles__code [];
access_requests -- access_requests__id [];
access_requests -- access_requests__status [];
access_requests -- access_requests__duration_days [];
access_requests -- access_requests__grant_expires_at [];
requester -- users [headlabel="1"];
requester -- access_requests [headlabel="N"];
requested_role -- roles [headlabel="1"];
requested_role -- access_requests [headlabel="N"];
request_app -- applications [headlabel="1"];
request_app -- access_requests [headlabel="N", color="#50616a:#ffffff:#50616a"];
request_origin -- departments [headlabel="1"];
request_origin -- access_requests [headlabel="N"];
}
